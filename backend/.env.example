APP_NAME="Central de Atendimento Operacional"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8088

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=operations_hub
DB_USERNAME=operations
DB_PASSWORD=operations

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=rabbitmq

CACHE_STORE=redis
CACHE_PREFIX=operations_hub_cache

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=operations
RABBITMQ_PASSWORD=operations
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=default
RABBITMQ_EXCHANGE_NAME=
ATTENDANCE_INTEGRATION_ENABLED=true
ATTENDANCE_INTEGRATION_QUEUE_CONNECTION=rabbitmq
ATTENDANCE_INTEGRATION_QUEUE=attendance-integrations
ATTENDANCE_INTEGRATION_WORKER_SLEEP=1
ATTENDANCE_INTEGRATION_WORKER_TRIES=3
ATTENDANCE_INTEGRATION_WORKER_TIMEOUT=30

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@operations-hub.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

DB_TEST_HOST=mysql_testing
DB_TEST_PORT=3306
DB_TEST_DATABASE=operations_hub_test
DB_TEST_USERNAME=operations_test
DB_TEST_PASSWORD=operations_test

VITE_APP_NAME="${APP_NAME}"
