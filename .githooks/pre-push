#!/usr/bin/env bash

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"

should_run_validation=0

while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "${local_ref}" != "(delete)" ]]; then
    should_run_validation=1
    break
  fi
done

if [[ "${should_run_validation}" -eq 0 ]]; then
  echo "Push de delecao detectado; validacoes do pre-push foram ignoradas."
  exit 0
fi

"${repo_root}/bin/pre-push-quality"
